---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cppcoreguidelines-owning-memory,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements

WarningsAsErrors: 'bugprone-*,cert-*,clang-analyzer-*,cppcoreguidelines-*'

CheckOptions:
  # Традиционный для Core Guidelines стиль именования (как в stl)
  - key:             readability-identifier-naming.Class
    value:           snake_case
  - key:             readability-identifier-naming.Function
    value:           snake_case
  - key:             readability-identifier-naming.Variable
    value:           snake_case
  - key:             readability-identifier-naming.MacroDefinition
    value:           UPPER_CASE
  # Ограничение на сложность функций
  - key:             readability-function-cognitive-complexity.Threshold
    value:           15

FormatStyle: file
...
